# ===== 清华 Info 账号（Step 2 登录用，绝不提交真实值到 git）=====
THU_USERNAME=你的学号
THU_PASSWORD=你的密码
# 固定设备指纹：32 位 hex，可用 node -e "console.log(require('crypto').randomUUID().replace(/-/g,''))" 生成
# 配合"信任此设备"可跳过每次登录的二次认证
THU_FINGERPRINT=

# ===== DeepSeek API（Step 10 Harness 阶段才需要）=====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DeepSeek API 地址，一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com
