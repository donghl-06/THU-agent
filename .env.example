# ===== 清华 Info 账号（Step 2 登录用，绝不提交真实值到 git）=====
THU_USERNAME=你的学号
THU_PASSWORD=你的密码
# 固定设备指纹（可选）：留空时清灵会自动生成并保存在本机，推荐留空
# 配合"信任此设备"可跳过每次登录的二次认证
THU_FINGERPRINT=

# ===== LLM API（Step 10 Harness 阶段才需要）=====
# 任意 OpenAI 兼容接口均可：Kimi / GLM / DeepSeek
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# Kimi for Coding 套餐（sk-kimi- 开头的 key 用这个端点）
LLM_BASE_URL=https://api.kimi.com/coding/v1
LLM_MODEL=k3-256k
# Kimi 普通开放平台（sk- 开头的 key）：LLM_BASE_URL=https://api.moonshot.cn/v1  LLM_MODEL=kimi-k2-0905-preview
# GLM（智谱）：LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4.6
# DeepSeek：  LLM_BASE_URL=https://api.deepseek.com               LLM_MODEL=deepseek-chat
# 图片输入（vision）开关：默认开（k3-256k 已实测支持）；换不支持 vision 的模型时设为 0
LLM_VISION=1
# token 单价（元/百万 token），可选：两个都填了才在界面上显示估算费用
# 例如 Kimi 普通 open 平台按模型定价页填入；不填只显示 token 数
LLM_PRICE_IN=20
LLM_PRICE_OUT=100

# ===== 校历（可选）：学期第一教学周的周一日期（YYYY-MM-DD）=====
# 配置后 system prompt 会注入"第 N 教学周"，课表类问题回答更准
SEMESTER_START=2026-09-14

# ===== Web UI 访问口令（可选）：局域网开放时防止同网他人使用 =====
# 配置后，浏览器首次打开页面需输入此口令（输一次即可，cookie 一年有效）
# 留空 = 不启用鉴权（仅本机 127.0.0.1 使用时无需配置）
# UI_TOKEN=换一个自己的口令

# ===== 超级鹰打码平台（预约场馆过滑块验证码用，不预约可不填）=====
# 注册：chaojiying.com → 软件 ID 在"软件管理"里创建，单次识别约 0.01 元
CJY_USER=
CJY_PASSWORD=
CJY_SOFT_ID=
